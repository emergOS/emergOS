{
  "name": "@emergos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm db:migrations:apply && wrangler deploy",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "typecheck": "pnpm types:worker && tsc --noEmit",
    "types:worker": "wrangler types",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "db:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vitejs/plugin-react": "^5.1.0",
    "hono": "^4.10.8",
    "lucide-react": "^0.555.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.16.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "wrangler": "^4.51.0"
  },
  "cloudflare": {
    "bindings": {
      "TURNSTILE_SECRET_KEY": {
        "description": "Cloudflare Turnstile secret key. Public submissions are rejected in production when this is missing."
      },
      "SESSION_SECRET": {
        "description": "Generate a random string with `openssl rand -hex 32`; reserved for future magic-link sessions."
      },
      "ADMIN_BOOTSTRAP_EMAIL": {
        "description": "Email address that should be treated as the first Owner when authenticated through Cloudflare Access."
      },
      "EMAIL_FORWARD_TO": {
        "description": "Optional verified forwarding address for future inbound tip routing."
      }
    }
  }
}
