{
  "name": "@emergos/create-emergos",
  "version": "0.1.0",
  "private": false,
  "description": "Create a deployable emergOS crisis response Worker starter.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-emergos": "./dist/index.js"
  },
  "files": [
